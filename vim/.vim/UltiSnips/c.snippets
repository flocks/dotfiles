snippet struct "structure in C" b
typedef struct ${1:name} $1
struct $1 {
  $0
};
endsnippet

snippet def "define" b
#define $0
endsnippet

snippet inc "include" b
#include <$1.h>
endsnippet

snippet Inc "include" b
#include "$1.h"
endsnippet

snippet main "main() (main)"
int main(int argc, char const *argv[])
{
  ${0:/* code */}
  return 0;
}
endsnippet

snippet for "for int loop (fori)"
for (${4:u64} ${2:i} = 0; $2 < ${1:count}; ${3:++$2}) {
  ${0:/* code */}
}
endsnippet

snippet while "while loop (while)"
while (${1:condition}) {
  ${0:/* code */}
}
endsnippet

snippet printf "printf .. (printf)"
printf("${1}\n", ${2});
endsnippet

snippet fprintf "fprintf ..."
fprintf(${1:stderr}, "${2:%s}\n"${2/([^%]|%%)*(%.)?.*/(?2:, :\);)/}$3${2/([^%]|%%)*(%.)?.*/(?2:\);)/}
endsnippet

snippet if "if .. (if)"
if (${1:/* condition */}) {
  ${0:/* code */}
}
endsnippet

snippet do "do...while loop (do)"
do {
  ${0:/* code */}
} while(${1:/* condition */});
endsnippet

snippet td "Typedef"
typedef ${1:int} ${2:MyCustomType};
endsnippet
