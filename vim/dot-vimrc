set completeopt=menuone
set hlsearch
set ignorecase
set mouse=a
set smartcase
set updatetime=5
set autoread
set colorcolumn=""
set autoindent
set encoding=utf-8
set expandtab
set hidden
set nohlsearch
set incsearch
set laststatus=2
set list
set listchars=tab:>-,trail:·,nbsp:% 
set pumheight=5
set relativenumber
