set noswapfile
set tabstop=2
set wildmenu
set wildmode=longest,full,full
set nowrap
set nowritebackup
set number
let g:netrw_banner = 0
let g:asyncrun_open = 8
let b:prettier_exec_cmd = "prettierd"
set t_Co=256
set background=dark
colorscheme lunaperche
syntax on

" registers to clipboard
nnoremap <leader>Y :let @+ = @%<CR>
nnoremap <leader>y :let @+ = expand('%:p')<CR>
nnoremap <leader>d :let @+ = expand('%:p:h')<CR>

" copy to system clipboard
vnoremap <C-y> "+y

nnoremap <C-x><C-j> :Explore<CR>

" Quickfix
nnoremap <A-p> :cprev<CR>  " Previous in quickfix list
nnoremap <A-n> :cnext<CR>  " Next in quickfix list
nnoremap <ESC>p :cprev<CR>  " Previous in quickfix list
nnoremap <ESC>n :cnext<CR>  " Next in quickfix list
nnoremap <space> :copen<CR> " Open quickfix list

" Split management
nnoremap vv <C-w>v          " Split window vertically
nnoremap ss <C-w>s          " Split window horizontally
nnoremap <C-h> <C-w>h       " Move to left window
nnoremap <C-l> <C-w>l       " Move to right window
nnoremap <C-j> <C-w>j       " Move to bottom window
nnoremap <C-k> <C-w>k       " Move to top window
nnoremap Q :qa!<CR>         " Move to top window

" Quick commands in insert mode
inoremap AA <Esc>A  " Go to line end
inoremap II <Esc>I  " Go to line start
inoremap OO <Esc>O  " Go to line above


" buffers
nnoremap <leader>b :ls<CR>:b
nnoremap <C-;> :ls<CR>:b

" Auto pair
inoremap ( ()<Left>
inoremap { {}<Left>
inoremap [ []<Left>
inoremap ' ''<Left>
inoremap " ""<Left>

" s/foo/bar
nnoremap <C-c><C-r> :%s/<C-r><C-w>/

set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case  " Use rg for :grep/lgrep
command! -nargs=* Sgrep silent! grep <args> | copen

" Search word under cursor and populate quickfix
nnoremap <leader>f :silent! grep -w  <C-r><C-w><CR>:copen<CR>

" Search word under cursor in current file and populate quickfix
nnoremap <leader>F :silent! grep -w  <C-r><C-w> %<CR>:copen<CR>

" Automatically populates some registers
" d contains current folder path (absolute)
" f contains current file name without extension
augroup AutoPopulateRegisters
  autocmd!
  autocmd BufEnter * call PopulateRegisters()
augroup END

function! PopulateRegisters()
  let current_file = expand("%:p")
  let folder = fnamemodify(current_file, ":p:h")
  let filename_without_extension = fnamemodify(current_file, ":t:r")
  let folder = folder . "/"

  call setreg('d', folder)
  call setreg('f', filename_without_extension)
endfunction

" open file on latest edited line
augroup LastEditedLine
  autocmd!
  autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
augroup END

" fzf
set rtp+=~/.fzf
nnoremap <C-p> :FZF<CR>


" Source plugin config if available
if 0 && !has('nvim')
  if filereadable(expand("~/.vim/plugins.vim"))
    source ~/.vim/plugins.vim
  endif

  " Source language-specific LSP configs
  if filereadable(expand("~/.vim/lsp/typescript.vim"))
    source ~/.vim/lsp/typescript.vim
  endif
endif
