" Search word under cursor in current file and populate quickfix
nnoremap <leader>F :grep -w  <C-r><C-w> %<CR>

" Automatically populates some registers
" d contains current folder path (absolute)
" f contains current file name without extension
augroup AutoPopulateRegisters
  autocmd!
  autocmd BufEnter * call PopulateRegisters()
augroup END

function! PopulateRegisters()
  let current_file = expand("%:p")
  let folder = fnamemodify(current_file, ":p:h")
  let filename_without_extension = fnamemodify(current_file, ":t:r")
  let folder = folder . "/"

  call setreg('d', folder)
  call setreg('f', filename_without_extension)
endfunction

" open file on latest edited line
augroup LastEditedLine
  autocmd!
  autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
augroup END