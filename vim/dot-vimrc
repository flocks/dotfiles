" registers to clipboard
nnoremap <leader>Y :let @+ = @%<CR>
nnoremap <leader>y :let @+ = expand('%:p')<CR>
nnoremap <leader>d :let @+ = expand('%:p:h')<CR>

" copy to system clipboard
vnoremap <C-y> "+y

nnoremap <C-x><C-j> :Explore<CR>

" Quickfix
nnoremap <A-p> :cprev<CR>  " Previous in quickfix list
nnoremap <A-n> :cnext<CR>  " Next in quickfix list
nnoremap <ESC>p :cprev<CR>  " Previous in quickfix list
nnoremap <ESC>n :cnext<CR>  " Next in quickfix list
nnoremap <space> :copen<CR> " Open quickfix list

" Split management
nnoremap vv <C-w>v          " Split window vertically
nnoremap ss <C-w>s          " Split window horizontally
nnoremap <C-h> <C-w>h       " Move to left window
nnoremap <C-l> <C-w>l       " Move to right window
nnoremap <C-j> <C-w>j       " Move to bottom window
