# edit confs
alias V="cd ~/dotfiles/nvim/.config/nvim && nvim init.lua"
alias I="cd ~/dotfiles/i3/.config/i3 && nvim config"
alias K="cd ~/dotfiles/kitty/.config/kitty && nvim kitty.conf"
alias Z="cd ~ && nvim .zshrc"

alias resource="source ~/.zshrc"

# folder
alias chess="cd ~/chessblind"
alias s="cd ~/screenshots"
alias mobile="cd ~/ledger/revault/packages/mobile"
alias S="cd ~/sandbox && v main.ts"
alias gof="cd ~/gof"
alias ex="cd ~/exvoto"
alias dl="cd ~/Downloads"
alias front="cd ~/ledger/ledger-vault-front"
alias f="cd ~/ledger/ledger-vault-front"
alias min="cd ~/ledger/minivault"
alias lli="cd ~/ledger/ledger-live"
alias llm="cd ~/ledger/ledger-live/apps/ledger-live-mobile"
alias vjs="cd ~/ledger/vault-ts"
alias apdu="cd ~/ledger/vault-apdu-connector"
alias remote="cd ~/ledger/vault-remote"
alias llc="cd ~/ledger/ledger-live-common"
alias driver="cd ~/ledger/ledger-vault-hsm-driver"
alias rr="cd ~/ledger/revault"
alias e2e="cd ~/ledger/vault-e2e-tests/"
alias inte="cd ~/.vault/vault-integration"
alias dot="cd ~/dotfiles"
alias vc="cd ~/dotfiles/nvim/.config/nvim"
alias hr="cd ~/holdem-range"
alias gate="cd ~/ledger/ledger-vault-api"
alias wd="cd ~/ledger/ledger-wallet-daemon"
alias dot="cd ~/dotfiles"
alias dp="cd ~/deeprun-front/"
alias b="cd ~/bin"
alias h="cd"
alias live="cd ~/ledger/ledger-live"
alias r="cd ~/ledger/revault"
alias rrm="cd ~/ledger/revault/packages/mobile"
alias rrs="cd ~/ledger/revault/packages/sdk"
alias rro="cd ~/ledger/revault/packages/onboarding"
alias rrd="cd ~/ledger/revault/packages/demo"
alias rrD="cd ~/ledger/revault/packages/dls"
alias rrw="cd ~/ledger/revault/packages/web"
alias rru="cd ~/ledger/revault/packages/ui"
alias rra="cd ~/ledger/revault/packages/api"
alias sig="cd ~/ledger/les-multisig-web"
alias vid="cd ~/Videos"


# git stuff
alias gs="git status"
alias gc="git commit"
alias gd="git diff"
alias gpo='git push -u origin $(git rev-parse --abbrev-ref HEAD)'
alias amend="git commit --amend"
alias amendd="git commit --amend --no-edit"
alias g="nvim '+Git|only'"
alias bb='git branch | fzf | xargs git checkout'
alias gfiles="git show --pretty=format: --name-only"

# programs
alias rgn="rg --vimgrep"
alias ydl="youtube-dl"
alias t="tmux attach"
alias ec='emacsclient -nw -c'
alias pic="sxiv"
alias v="nvim"
alias xv="xargs nvim"
alias vim="nvim"
alias lg="lazygit"
alias img="sxiv"
alias nb=newsboat
alias m="cd ~/music"
alias hdcast='ffcast -s ffmpeg -f x11grab -framerate 60 -show_region 1 -s %s -i %D+%c -c:v libx264rgb -crf 0 -preset ultrafast'
alias tign='tig --no-merges'
alias player="ncmpcpp"
alias vimup="vim +'PlugUpgrade|PlugInstall|PlugUpdate|qa!'"
alias vgit="nvim -c ':Git' -c ':only'"
alias lv="ledger-vault"
alias lvo="ledger-vault run onboarding"
alias lvco="ledger-vault create user --role operator --name $(date +%s)"
alias lvca="ledger-vault create user --role admin --name $(date +%s)"
alias music="ncmpcpp"
alias i="instances"

#emacs links
alias mg="magit"
# alias p="pnpm"

# utils
alias make="make 2>&1"
alias tvi="pnpm typecheck  | sed -E 's/\(([0-9]+),([0-9]+)\): error TS/:\1:\2: error TS/' | tee /tmp/error.log && nvim -q <(cat /tmp/error.log) '+copen'"
alias gb="git branch -r --contains"
alias fn="find . -name"
alias fic="find-in-code.sh"
alias rgc="find-in-code.sh | xargs rg"
alias pcopy="pwd | copy"
alias pc="pwd | copy"
alias bindings="grep bindsym ~/.config/i3/config | sed s/bindsym// | dmenu -l 10"
alias chmox="chmod +x"
alias ls="ls --color"
alias ll="ls -l"
alias l="ls -l --group-directories-first"
alias q="exit"
alias cfgs="cat ~/dotfiles/configs"
alias c="~/bin/configs"
alias rg='rg --hidden --line-number --column'
alias rgfiles="cut -d : -f 1 | sort | uniq"
alias rv="cut -d : -f 1 | sort | uniq | xargs nvim"
alias difffiles="cut -d' ' -f 2 | sort | uniq"
alias flowfiles='rg "^Error" | cut -d " " -f 3 | cut -d : -f 1 | sort | uniq'
# useful to pipe, eg cat file.log | copy
alias copy="xclip -selection c"
alias killdocker='ps aux | rg docker | rg containerd-shim | awk "{ print $2 }" | xargs -r sudo kill -9'
alias dstart='docker ps | rg starting | wc -l'
alias u='source monorepo-nav.sh'


alias kb="keyboard_plug"
